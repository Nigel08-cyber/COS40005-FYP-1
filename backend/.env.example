# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma separated frontend origins allowed by CORS (needed for cookies)
CORS_ORIGINS=http://localhost:3000,https://cos-40005-fyp-1.vercel.app
# Cross-site refresh cookie (Vercel -> Tailscale Funnel) needs secure=true, samesite=none
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Password reset links point at the frontend (set to the Vercel URL when deployed)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_MINUTES=30
# "log" prints the reset link in the server log; switch to brevo once item 26 exists
EMAIL_BACKEND=log
