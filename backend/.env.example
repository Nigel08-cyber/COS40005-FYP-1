# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma separated frontend origins allowed by CORS (needed for cookies)
CORS_ORIGINS=http://localhost:3000,https://cos-40005-fyp-1.vercel.app
# Cross-site refresh cookie (Vercel -> Tailscale Funnel) needs secure=true, samesite=none
COOKIE_SECURE=true
COOKIE_SAMESITE=none
