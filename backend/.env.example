# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Comma separated frontend origins allowed by CORS (needed for cookies)
CORS_ORIGINS=http://localhost:3000,https://cos-40005-fyp-1.vercel.app
# Cross-site refresh cookie (Vercel -> Tailscale Funnel) needs secure=true, samesite=none
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Password reset links point at the frontend (set to the Vercel URL when deployed)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_MINUTES=30
# "log" prints mails (and the reset link) in the server log; "brevo" sends real email
EMAIL_BACKEND=log
# Needed when EMAIL_BACKEND=brevo. The sender address must be verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Tandem

# --- Sprint 3 ---
# "production" makes the backend refuse to start with an unsafe config (default JWT_SECRET, COOKIE_SECURE=false, localhost CORS)
ENVIRONMENT=development
# Emails show this time zone (the database stays UTC)
DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
# Scheduler (reminders, thank-yous). Run ONE backend process.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
REMINDER_HOURS_BEFORE=24
POST_EVENT_WINDOW_DAYS=3
# QR attendance
QR_TTL_MINUTES=5
CHECKIN_EARLY_MINUTES=30
CHECKOUT_GRACE_MINUTES=180
# true behind Tailscale Funnel so the audit log records the real client IP
TRUST_PROXY_HEADERS=false
